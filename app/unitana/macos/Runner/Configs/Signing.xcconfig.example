// Copy to `app/unitana/macos/Runner/Configs/Signing.xcconfig` for local release signing.
// Keep the real file uncommitted.
//
// Automatic signing example:
// DEVELOPMENT_TEAM = YOURTEAMID
// CODE_SIGN_STYLE = Automatic
//
// Optional manual-signing overrides:
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Apple Distribution
// PROVISIONING_PROFILE_SPECIFIER = Unitana Mac Distribution
